{\rtf1\ansi\ansicpg1252\deff0\nouicompat\deflang1033{\fonttbl{\f0\fnil\fcharset0 Calibri;}}
{\*\generator Riched20 10.0.19041}\viewkind4\uc1 
\pard\sa200\sl276\slmult1\f0\fs22\lang9 CREATE DATABASE OrderDB;\par
USE OrderDB;\par
CREATE TABLE Customer (\par
    Customer_ID INT PRIMARY KEY,\par
    Customer_Name VARCHAR(50) NOT NULL,\par
    Email VARCHAR(100) UNIQUE,\par
    City VARCHAR(50)\par
);\par
CREATE TABLE Product (\par
    Product_ID INT PRIMARY KEY,\par
    Product_Name VARCHAR(50) NOT NULL,\par
    Price DECIMAL(10,2) NOT NULL CHECK (Price > 0)\par
);\par
CREATE TABLE Orders (\par
    Order_ID INT PRIMARY KEY,\par
    Customer_ID INT NOT NULL,\par
    Order_Date DATE NOT NULL,\par
    Total_Amount DECIMAL(10,2) DEFAULT 0\par
        CHECK (Total_Amount >= 0),\par
    Order_Status VARCHAR(20) DEFAULT 'Pending'\par
        CHECK (Order_Status IN\par
        ('Pending', 'Shipped', 'Delivered', 'Cancelled')),\par
    FOREIGN KEY (Customer_ID)\par
        REFERENCES Customer(Customer_ID)\par
);\par
CREATE TABLE Order_Details (\par
    Order_Detail_ID INT PRIMARY KEY,\par
    Order_ID INT NOT NULL,\par
    Product_ID INT NOT NULL,\par
    Quantity INT NOT NULL CHECK (Quantity > 0),\par
    Price DECIMAL(10,2) NOT NULL CHECK (Price > 0),\par
    FOREIGN KEY (Order_ID) REFERENCES Orders(Order_ID),\par
    FOREIGN KEY (Product_ID) REFERENCES Product(Product_ID),\par
    UNIQUE (Order_ID, Product_ID)\par
);\par
INSERT INTO Customer VALUES\par
(1, 'Aparna', 'aparna@gmail.com', 'Chennai'),\par
(2, 'Rahul', 'rahul@gmail.com', 'Delhi'),\par
(3, 'Priya', 'priya@gmail.com', 'Mumbai'),\par
(4, 'Kumar', 'kumar@gmail.com', 'Chennai');\par
INSERT INTO Product VALUES\par
(101, 'Laptop', 50000),\par
(102, 'Mouse', 500),\par
(103, 'Keyboard', 1000),\par
(104, 'Headphone', 1500);\par
INSERT INTO Orders VALUES\par
(1001, 1, '2026-10-20', 51000, 'Pending'),\par
(1002, 2, '2026-10-21', 2000, 'Shipped'),\par
(1003, 1, '2026-10-22', 1500, 'Delivered'),\par
(1004, 3, '2026-10-23', 500, 'Pending');\par
INSERT INTO Order_Details VALUES\par
(1, 1001, 101, 1, 50000),\par
(2, 1001, 102, 2, 500),\par
(3, 1002, 103, 2, 1000),\par
(4, 1003, 104, 1, 1500),\par
(5, 1004, 102, 1, 500);\par
SELECT * FROM Orders;\par
UPDATE Orders\par
SET Order_Status = 'Shipped'\par
WHERE Order_ID = 1001;\par
UPDATE Orders\par
SET Order_Status = 'Delivered'\par
WHERE Order_ID = 1002;\par
UPDATE Order_Details\par
SET Quantity = 3\par
WHERE Order_Detail_ID = 2;\par
UPDATE Orders\par
SET Total_Amount = (\par
    SELECT SUM(Quantity * Price)\par
    FROM Order_Details\par
    WHERE Order_ID = 1001\par
)\par
WHERE Order_ID = 1001;\par
DELETE FROM Order_Details\par
WHERE Order_ID = 1004;\par
DELETE FROM Orders\par
WHERE Order_ID = 1004\par
AND Order_Status = 'Cancelled';\par
SELECT\par
    o.Order_ID,\par
    c.Customer_Name,\par
    p.Product_Name,\par
    od.Quantity,\par
    od.Price,\par
    (od.Quantity * od.Price) AS Subtotal,\par
    o.Order_Date,\par
    o.Total_Amount,\par
    o.Order_Status\par
FROM Orders o\par
JOIN Customer c ON o.Customer_ID = c.Customer_ID\par
JOIN Order_Details od ON o.Order_ID = od.Order_ID\par
JOIN Product p ON od.Product_ID = p.Product_ID\par
ORDER BY o.Order_ID;\par
SELECT\par
    c.Customer_ID,\par
    c.Customer_Name,\par
    o.Order_ID,\par
    o.Order_Date,\par
    p.Product_Name,\par
    od.Quantity,\par
    od.Price,\par
    o.Order_Status\par
FROM Customer c\par
JOIN Orders o ON c.Customer_ID = o.Customer_ID\par
JOIN Order_Details od ON o.Order_ID = od.Order_ID\par
JOIN Product p ON od.Product_ID = p.Product_ID\par
ORDER BY c.Customer_ID, o.Order_Date;\par
SELECT\par
    p.Product_Name,\par
    o.Order_ID,\par
    od.Quantity,\par
    od.Price\par
FROM Product p\par
JOIN Order_Details od ON p.Product_ID = od.Product_ID\par
JOIN Orders o ON od.Order_ID = o.Order_ID;\par
SELECT\par
    p.Product_Name,\par
    COUNT(DISTINCT od.Order_ID) AS Times_Ordered\par
FROM Product p\par
LEFT JOIN Order_Details od ON p.Product_ID = od.Product_ID\par
GROUP BY p.Product_ID, p.Product_Name;\par
SELECT\par
    p.Product_Name,\par
    COALESCE(SUM(od.Quantity), 0) AS Total_Quantity_Sold\par
FROM Product p\par
LEFT JOIN Order_Details od ON p.Product_ID = od.Product_ID\par
GROUP BY p.Product_ID, p.Product_Name;\par
SELECT Customer_ID, Customer_Name, Order_Count\par
FROM (\par
    SELECT\par
        c.Customer_ID,\par
        c.Customer_Name,\par
        COUNT(o.Order_ID) AS Order_Count\par
    FROM Customer c\par
    JOIN Orders o ON c.Customer_ID = o.Customer_ID\par
    GROUP BY c.Customer_ID, c.Customer_Name\par
) AS T\par
WHERE Order_Count = (\par
    SELECT MAX(Order_Count)\par
    FROM (\par
        SELECT COUNT(*) AS Order_Count\par
        FROM Orders\par
        GROUP BY Customer_ID\par
    ) AS X\par
);\par
SELECT\par
    c.Customer_Name,\par
    COALESCE(SUM(o.Total_Amount), 0) AS Total_Spending\par
FROM Customer c\par
LEFT JOIN Orders o ON c.Customer_ID = o.Customer_ID\par
AND o.Order_Status <> 'Cancelled'\par
GROUP BY c.Customer_ID, c.Customer_Name;\par
SELECT AVG(Total_Amount) AS Average_Order_Value\par
FROM Orders\par
WHERE Order_Status <> 'Cancelled';\par
SELECT SUM(Total_Amount) AS Total_Sales\par
FROM Orders\par
WHERE Order_Status <> 'Cancelled';\par
SELECT Order_Status, COUNT(*) AS Total_Orders\par
FROM Orders\par
GROUP BY Order_Status;\par
\par

